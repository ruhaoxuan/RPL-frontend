{
  "name": "rpl-knowledge-base",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run data:build && vite --host 127.0.0.1",
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/check-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "tsx tests/browser.ts",
    "build": "npm run data:build && npm run data:check && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts metadata tests *.ts *.json index.html README.md",
    "data:import": "python3 scripts/import_allowlist.py",
    "data:table": "tsx scripts/mapping-table.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.0",
    "shiki": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "zod": "^4.0.0"
  }
}
